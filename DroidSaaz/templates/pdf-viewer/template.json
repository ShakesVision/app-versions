{
  "id": "pdf-viewer-v1",
  "name": "PDF / Image Book",
  "version": 2,
  
  "sections": [
    {
      "id": "content",
      "type": "form",
      "labels": {"en": "Content", "ar": "المحتوى", "ur": "مواد"},
      "icon": "edit",
      "fields": [
        {
          "id": "title",
          "type": "text",
          "required": true,
          "labels": {"en": "Book Title", "ar": "عنوان الكتاب", "ur": "کتاب کا عنوان"},
          "placeholder": {"en": "Enter book title", "ar": "أدخل عنوان الكتاب", "ur": "کتاب کا عنوان درج کریں"},
          "maxLength": 100
        },
        {
          "id": "author",
          "type": "text",
          "required": false,
          "labels": {"en": "Author Name", "ar": "اسم المؤلف", "ur": "مصنف کا نام"},
          "placeholder": {"en": "Enter author name (optional)", "ar": "أدخل اسم المؤلف (اختياري)", "ur": "مصنف کا نام درج کریں (اختیاری)"}
        },
        {
          "id": "cover",
          "type": "image",
          "required": false,
          "labels": {"en": "Cover Image", "ar": "صورة الغلاف", "ur": "سرورق کی تصویر"},
          "aspectRatio": "2:3"
        },
        {
          "id": "pages",
          "type": "images",
          "required": true,
          "labels": {"en": "Book Pages", "ar": "صفحات الكتاب", "ur": "کتاب کے صفحات"},
          "placeholder": {"en": "Select PDF pages or images", "ar": "اختر صفحات PDF أو صور", "ur": "PDF صفحات یا تصاویر منتخب کریں"}
        },
        {
          "id": "description",
          "type": "textarea",
          "required": false,
          "labels": {"en": "Description", "ar": "وصف", "ur": "تفصیل"},
          "placeholder": {"en": "Brief description of the book", "ar": "وصف موجز للكتاب", "ur": "کتاب کی مختصر تفصیل"},
          "maxLength": 500
        }
      ]
    },
    {
      "id": "customize",
      "type": "customize",
      "labels": {"en": "Customize", "ar": "تخصيص", "ur": "ترتیب"},
      "icon": "palette",
      "colors": [
        {"id": "primary", "labels": {"en": "Primary Color", "ar": "اللون الأساسي", "ur": "بنیادی رنگ"}, "default": "#1976D2"},
        {"id": "background", "labels": {"en": "Background", "ar": "الخلفية", "ur": "پس منظر"}, "default": "#F5F5F5"},
        {"id": "toolbar", "labels": {"en": "Toolbar Color", "ar": "لون شريط الأدوات", "ur": "ٹول بار کا رنگ"}, "default": "#FFFFFF"}
      ],
      "direction": {
        "labels": {"en": "Page Direction", "ar": "اتجاه الصفحة", "ur": "صفحے کی سمت"},
        "options": ["ltr", "rtl"],
        "default": "ltr",
        "perChapter": false
      }
    }
  ]
}
