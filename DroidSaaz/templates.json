{
  "version": 2,
  "baseUrl": "https://raw.githubusercontent.com/ShakesVision/app-versions/main/DroidSaaz",
  "templates": [
    {
      "id": "book-app-v1",
      "name": "Book App",
      "description": "Create a beautiful reading app with chapters, table of contents, and customizable themes",
      "icon": "templates/book-app/icon.png",
      "preview": "templates/book-app/preview.png",
      "templatePath": "templates/book-app",
      "files": [
        "template.json",
        "index.html",
        "styles/utils.css",
        "styles/book.css",
        "scripts/app.js"
      ],
      "templateVersion": 1,
      "category": "reading",
      "features": [
        "chapters",
        "toc",
        "dark-mode",
        "rtl-support",
        "custom-fonts"
      ]
    },
    {
      "id": "pdf-viewer-v1",
      "name": "PDF / Image Book",
      "description": "Create a PDF-style viewer app from images. Perfect for ebooks, magazines, comics, and manuals",
      "icon": "templates/pdf-viewer/icon.png",
      "preview": "templates/pdf-viewer/preview.png",
      "templatePath": "templates/pdf-viewer",
      "files": [
        "template.json",
        "index.html",
        "styles/utils.css",
        "styles/pdf.css",
        "scripts/app.js"
      ],
      "templateVersion": 1,
      "category": "reading",
      "features": [
        "zoom",
        "thumbnails",
        "bookmarks",
        "dark-mode",
        "rtl-support",
        "fullscreen"
      ]
    }
  ]
}
